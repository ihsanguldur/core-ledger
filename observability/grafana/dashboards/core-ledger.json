{
  "title": "core-ledger",
  "uid": "core-ledger",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Internal transfer attempts / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(ledger_transfer_attempts_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "External transfer attempts / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(ledger_external_transfer_attempts_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Internal transfer avg latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ledger_transfer_duration_seconds_sum[1m]) / rate(ledger_transfer_duration_seconds_count[1m])",
          "legendFormat": "avg duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "External transfer avg latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(ledger_external_transfer_duration_seconds_sum[1m]) / rate(ledger_external_transfer_duration_seconds_count[1m])",
          "legendFormat": "avg duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Internal transfer error rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(ledger_transfer_attempts_total{outcome=\"failure\"}[5m])) / sum(rate(ledger_transfer_attempts_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "External transfer rejection rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(ledger_external_transfer_attempts_total{outcome=\"rejected\"}[5m])) / sum(rate(ledger_external_transfer_attempts_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}